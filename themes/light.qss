/* QEncoder — 浅色主题（白底 + 蓝色强调） */

QWidget {
    color: #1f2328;
}

QMainWindow, QDialog {
    background-color: #f3f5f8;
}

QStackedWidget {
    background: transparent;
}

/* ---------- 工具栏 ---------- */
QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #dfe3e8;
    padding: 7px 12px;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background: #dfe3e8;
    margin: 6px 8px;
}

QToolButton {
    background: transparent;
    color: #1f2328;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 10px;
}

QToolButton:hover {
    background-color: #eef1f5;
    border-color: #dfe3e8;
}

QToolButton:pressed {
    background-color: #e5e9ef;
}

QToolButton:disabled {
    color: #6b7280;
}

/* 任务表行内操作按钮：紧凑图标按钮 */
QWidget#rowActions QToolButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 0;
}

QWidget#rowActions QToolButton:hover {
    background-color: #eef1f5;
}

QWidget#rowActions QToolButton:pressed {
    background-color: #e5e9ef;
}

/* ---------- 任务表 ---------- */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
    gridline-color: transparent;
    selection-background-color: #e3edff;
    selection-color: #1f2328;
}

QTableWidget::item {
    padding: 6px 10px;
}

QTableWidget::item:selected {
    background-color: #e3edff;
    color: #1f2328;
}

QHeaderView::section {
    background-color: #f6f8fa;
    color: #6b7280;
    border: none;
    border-bottom: 1px solid #dfe3e8;
    padding: 10px;
    font-weight: 600;
}

QHeaderView::section:first {
    border-top-left-radius: 10px;
}

QHeaderView::section:last {
    border-top-right-radius: 10px;
}

QTableCornerButton::section {
    background-color: #f6f8fa;
    border: none;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background-color: #e6eaef;
    border: none;
    border-radius: 4px;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 4px;
}

QLabel#progressValue {
    color: #1f2328;
    font-size: 11px;
}

/* ---------- 输入控件 ---------- */
QLineEdit, QSpinBox, QComboBox {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #dfe3e8;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 20px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #2563eb;
}

QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    color: #6b7280;
    background-color: #f6f8fa;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #dfe3e8;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #e3edff;
    selection-color: #1f2328;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    border-radius: 6px;
}

QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    background: transparent;
    border: none;
}

QSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #eef1f5;
    border-radius: 3px;
}

QSpinBox::up-arrow {
    image: url(:/icons/chevron-up.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c6ccd4;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #2563eb;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
    image: url(:/icons/check.svg);
}

QCheckBox::indicator:disabled {
    background-color: #f6f8fa;
    border-color: #dfe3e8;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #dfe3e8;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #eef1f5;
    border-color: #c6ccd4;
}

QPushButton:pressed {
    background-color: #e5e9ef;
}

QPushButton:disabled {
    color: #6b7280;
    background-color: #f6f8fa;
}

QPushButton[accent="true"] {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #2563eb;
    font-weight: 600;
}

QPushButton[accent="true"]:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

QPushButton[accent="true"]:pressed {
    background-color: #1e40af;
    border-color: #1e40af;
}

QPushButton[danger="true"] {
    color: #cf222e;
}

QPushButton[danger="true"]:hover {
    background-color: #fdecec;
    border-color: #cf222e;
}

/* ---------- 列表 ---------- */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
    padding: 6px;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #eef1f5;
}

QListWidget::item:selected {
    background-color: #e3edff;
    color: #1f2328;
}

/* ---------- 分组与卡片 ---------- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #6b7280;
}

QFrame#card {
    background-color: #f8fafc;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
}

QFrame#previewEmpty {
    background-color: #ffffff;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
}

/* ---------- 文本 ---------- */
QLabel#sectionTitle {
    color: #1f2328;
    font-weight: 600;
}

QLabel#hintLabel {
    color: #6b7280;
}

QLabel#emptyTitle {
    color: #1f2328;
    font-size: 20px;
    font-weight: 600;
}

QLabel#emptyHint {
    color: #6b7280;
}

QLabel#envStatus {
    color: #6b7280;
    padding-right: 8px;
}

QLabel#queueSummary {
    color: #6b7280;
    padding-left: 8px;
}

QLabel#envStatus[state="ok"] {
    color: #1a7f37;
}

QLabel#envStatus[state="missing"] {
    color: #cf222e;
}

/* ---------- 状态栏 / 提示 / 菜单 ---------- */
QStatusBar {
    background-color: #ffffff;
    color: #6b7280;
    border-top: 1px solid #dfe3e8;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #c6ccd4;
    padding: 6px 8px;
    border-radius: 6px;
}

QMenuBar {
    background-color: #ffffff;
    color: #1f2328;
    border-bottom: 1px solid #dfe3e8;
}

QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #e3edff;
    border-radius: 6px;
}

QMenu {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #dfe3e8;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 10px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #e3edff;
}

QMenu::separator {
    height: 1px;
    background: #dfe3e8;
    margin: 4px 8px;
}

QMessageBox {
    background-color: #ffffff;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background-color: #c6ccd4;
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6b7280;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background-color: #c6ccd4;
    min-width: 28px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6b7280;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
